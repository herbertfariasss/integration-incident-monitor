# Somente credenciais locais fictícias. Substitua se compartilhar a máquina.
POSTGRES_DB=incidents
POSTGRES_USER=incident
POSTGRES_PASSWORD=local-demo-only
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BASE_DELAY_SECONDS=5

# Execução da API fora do Compose
DATABASE_URL=postgresql://incident:local-demo-only@localhost:5432/incidents

# Opcionais: análise por IA; deixe vazios para desabilitar
AI_API_URL=
AI_API_KEY=
AI_MODEL=
